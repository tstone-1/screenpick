{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler"
  }
  // SvelteKit 3 requires this file to extend $app/tsconfig and to state
  // include/exclude itself; TypeScript does not merge them from the base.
  // `#lib/*` is a subpath import declared in package.json's `imports` field;
  // it names the real file, extension included (`#lib/editor.svelte.ts`),
  // which is what allowImportingTsExtensions permits.
}
